# Copy to .env — NEVER commit .env. Testnet keys only.
ARC_RPC=https://rpc.testnet.arc.io
# Operator/deployer wallet (deploys, funds the agent, sends anchors, and is the
# default vault KEEPER + rebalance signer).
# Generate with: npm run genwallet   Fund at: https://faucet.circle.com (Arc Testnet, USDC)
PRIVATE_KEY=
# Demo buyer agent's own wallet. Generate + top up with: npm run setup-agent
AGENT_PRIVATE_KEY=

# --- Signal-Vault (DeFi track) ------------------------------------------------
# Set automatically by `npm run deploy-vault` (written to vault/deployment.json);
# override here to point the keeper at a specific instance.
# VAULT_ADDRESS=
# Vault keeper address (who may call rebalance). Defaults to the operator.
# VAULT_KEEPER=
# LIVE signed consensus only: a funded Base-MAINNET USDC wallet for the $0.03
# x402 call. Leave unset to run the clearly-labeled self-signed sample instead.
# BUYER_PRIVATE_KEY=
# X402_NETWORK=base
# MAX_PRICE_USD=0.05
# Decision thresholds (transparent rule in vault/decide.mjs).
# FLOW_MIN_USD=5000
# MIN_SMART_WALLETS=3
# WATCH_MARKET=top

# Optional overrides
# ARC_CONTRACT=0x3474Bd2747cb1D430C2F56050433fa5D6b1C82A5
# GATEWAY_PORT=8402
# GATEWAY_URL=http://localhost:8402
